<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="counterdraft"
        Arguments=""
        InstallLocation="C:\Program Files\naghim\counterdraft">
    </Installer>
    <PackageInformation
        PackageName="counterdraft"
        PackageDisplayName="counterdraft"
        PublisherName="CN=naghim"
        PublisherDisplayName="naghim"
        Version="0.1.0.0"
        PackageDescription="An application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="me.naghi.counterdraft"
                Description="An application"
                DisplayName="counterdraft"
                ExecutableName="counterdraft"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>counterdraft</DisplayName>
            <PublisherDisplayName>naghim</PublisherDisplayName>
            <Description>An application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="counterdraft.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
